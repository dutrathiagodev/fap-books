# Copie para .env.local e preencha. Nunca commite valores reais.
# Chaves em: Supabase → Project Settings → API Keys (projeto fap-books, São Paulo).

# URL pública do projeto (não é segredo)
NEXT_PUBLIC_SUPABASE_URL=https://znqkjvpvkbcpsrhtflgp.supabase.co

# Chave PÚBLICA do Supabase (no painel aparece como "Publishable key", começa com sb_publishable_).
# Pode ir ao navegador, porque o acesso é limitado pelo RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave SECRETA ("Secret key", sb_secret_): só no servidor, nunca no navegador nem no Git.
# Painel: Project Settings → API Keys → "Secret key". Ignora o RLS, então só vale no servidor (sem NEXT_PUBLIC_).
# Usada no cadastro de usuários (convite por e-mail). Quem rodar essa tela precisa dela no .env.local;
# em produção, cadastre-a nas variáveis de ambiente da Vercel. Sem ela, o cadastro de usuários dá erro.
SUPABASE_SERVICE_ROLE_KEY=

# Endereço público do site, usado no link do e-mail de convite (/definir-senha). Só vale se estiver na lista de
# origens permitidas (src/lib/site-url.ts): produção, previews da Vercel e localhost. Local: a porta que você usa.
# Sem ela, produção usa https://fap-books.vercel.app e o ambiente local usa http://localhost:3000.
# O endereço também precisa estar em Authentication > URL Configuration > Redirect URLs (docs/email/README.md).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
